    "@types/react": "^19.1.10", "@types/react-dom": "^19.1.9", "@types/node": "^24.3.0",
    "vitest": "^3.2.4", "jsdom": "^26.1.0", "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.8.0", "@playwright/test": "^1.55.0"
  }
